# Custom ignore rules for pingfederate-go-client

# Don't generate files for ...Shared and ...AllOf enums. The generator creates these but they are not used.
model_*_all_of.go
model_*_shared.go
docs/*AllOf.md
docs/*Shared.md

# Unused files
git_push.sh
.travis.yml

# Ignore go.mod so that the version specifier (like v9.1.0.0) doesn't get overwritten in branches,
# And so that we use the top-level go.mod and go.sum files in the repository root
go.mod
go.sum

# Hand-written files in the SDK repo (rsync --delete must never remove them)
client_ext.go
generator.go
oauth2.go
